# RateIt – Environment Variables
# For local dev: copy to .env.local
# For docker-compose deploy: copy to .env (docker compose reads it automatically)

# Port the server listens on (default: 3000)
PORT=3000

# Directory for the SQLite database + uploaded images (default: ./data)
DATA_DIR=./data

# Comma-separated usernames (case-insensitive) that get admin access automatically on login
ADMIN_USERNAMES=arik_admin

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX). Leave empty to disable GA4.
# NOTE: this is inlined into the frontend at BUILD time — changing it requires
# `docker compose build` again, a plain `npm run dev`/`next build` restart is enough locally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Tunnel token (from the Cloudflare Zero Trust dashboard: Networks > Tunnels
# > your tunnel > Install connector > Docker — copy just the --token value).
# Only needed if you're using the cloudflared service in docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=
