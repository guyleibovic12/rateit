# RateIt – Environment Variables
# Copy this file to .env.local for local dev, or set these in your deployment platform.

# Port the server listens on (default: 3000)
PORT=3000

# Directory for the SQLite database + uploaded images (default: ./data)
DATA_DIR=./data

# Comma-separated usernames (case-insensitive) that get admin access automatically on login
ADMIN_USERNAMES=arik_admin
